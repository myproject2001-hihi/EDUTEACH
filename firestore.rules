rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if user is a teacher or admin
    function isTeacher() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')) ||
        (request.auth.token != null && 
         'email' in request.auth.token && 
         (request.auth.token.email.endsWith('@eduteach.com') || 
          request.auth.token.email.endsWith('@educonnect.com') ||
          request.auth.token.email == 'qtvminhngoc0204@educonnect.com'))
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // Reset requests collection
    match /reset_requests/{requestId} {
      allow read, write: if true;
    }

    // Assignments collection
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Teachers can create, or general during setup
    }

    // Submissions collection
    match /submissions/{submissionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Students can write their own, teachers can grade
    }

    // Class sessions collection
    match /class_sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Simulations collection
    match /simulations/{simulationId=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Student progress collection
    match /student_progress/{progressId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // System notifications collection
    match /system_notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }

    // Love letters collection
    match /love_letters/{letterId} {
      allow read: if isAuthenticated();
      allow create: if isTeacher();
      allow update: if isAuthenticated();
      allow delete: if isTeacher();
    }

    match /settings/{document=**} {
      allow read, write: if isTeacher();
    }
  }
}
