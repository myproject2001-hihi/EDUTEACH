rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /tuition_settings/{settingId} {
      allow read, write: if true;
    }

    match /tuition_receipts/{receiptId} {
      allow read, write: if true;
    }

    match /assignments/{assignmentId} {
      allow read, write: if true;
    }

    match /submissions/{submissionId} {
      allow read, write: if true;
    }

    match /student_interactions/{interactionId} {
      allow read, write: if true;
    }

    match /student_attempts/{attemptId} {
      allow read, write: if true;
    }

    match /class_sessions/{sessionId} {
      allow read, write: if true;
    }

    match /simulations/{simulationId=**} {
      allow read, write: if true;
    }

    match /question_sets/{setId} {
      allow read, write: if true;
    }

    match /student_progress/{progressId} {
      allow read, write: if true;
    }

    match /system_notifications/{notificationId} {
      allow read, write: if true;
    }

    match /love_letters/{letterId} {
      allow read, write: if true;
    }

    match /activity_logs/{logId} {
      allow read, write: if true;
    }

    match /privilege_cards/{cardId} {
      allow read, write: if true;
    }

    match /settings/{document=**} {
      allow read, write: if true;
    }

    match /resource_requests/{requestId} {
      allow read, write: if true;
    }

    match /student_attendances/{attendanceId} {
      allow read, write: if true;
    }

    match /student_evaluations/{evalId} {
      allow read, write: if true;
    }

    match /classroom_records/{recordId} {
      allow read, write: if true;
    }

    match /system_config/{configId} {
      allow read, write: if true;
    }

    match /reset_requests/{requestId} {
      allow read, write: if true;
    }
  }
}


