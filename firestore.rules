rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if user is a teacher or admin
    function isTeacher() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')) ||
        (request.auth.token != null && 
         'email' in request.auth.token && 
         (request.auth.token.email.endsWith('@eduteach.com') || 
          request.auth.token.email.endsWith('@educonnect.com') ||
          request.auth.token.email == 'qtvminhngoc0204@educonnect.com'))
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // Reset requests collection
    match /reset_requests/{requestId} {
      allow read, write: if true;
    }

    // Assignments collection
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated(); // Teachers create, students update viewed status
      allow delete: if isTeacher() || (isAuthenticated() && resource.data.teacherId == request.auth.uid);
    }

    // Submissions collection
    match /submissions/{submissionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Students can write their own, teachers can grade
    }

    // Student interactions collection
    match /student_interactions/{interactionId} {
      allow read, write: if isAuthenticated();
    }

    // Student attempts collection
    match /student_attempts/{attemptId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Class sessions collection
    match /class_sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Simulations collection
    match /simulations/{simulationId=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Student progress collection
    match /student_progress/{progressId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // System notifications collection
    match /system_notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isTeacher() || (isAuthenticated() && resource.data.teacherId == request.auth.uid) || (isAuthenticated() && resource.data.senderId == request.auth.uid);
    }

    // Love letters collection
    match /love_letters/{letterId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Activity logs collection (Lịch sử thao tác hệ thống)
    match /activity_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isTeacher();
    }

    // Perks collection
    match /privilege_cards/{cardId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }

    match /settings/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }
    
    // Resource requests collection
    match /resource_requests/{requestId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Student attendances and evaluations
    match /student_attendances/{attendanceId} {
      allow read, write: if isAuthenticated();
    }
    match /student_evaluations/{evalId} {
      allow read, write: if isAuthenticated();
    }
    match /classroom_records/{recordId} {
      allow read, write: if isAuthenticated();
    }

    // System config collection (game statuses, global app settings)
    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
