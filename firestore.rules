rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if user is a teacher or admin
    function isTeacher() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')) ||
        (request.auth.token != null && 
         'email' in request.auth.token && 
         request.auth.token.email.endsWith('@eduteach.com'))
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow create, delete: if isAuthenticated();
      allow update: if isAuthenticated() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['zaloChatId']));
    }

    // Reset requests collection
    match /reset_requests/{requestId} {
      allow read, write: if true;
    }

    // Assignments collection
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Teachers can create, or general during setup
    }

    // Submissions collection
    match /submissions/{submissionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Students can write their own, teachers can grade
    }

    // Class sessions collection
    match /class_sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Simulations collection
    match /simulations/{simulationId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Student progress collection
    match /student_progress/{progressId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    // Settings collection
    match /settings/zalo_bot {
      allow read: if true;
      allow write: if isTeacher();
    }
    match /settings/{document=**} {
      allow read, write: if isTeacher();
    }
  }
}
