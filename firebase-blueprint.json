{
  "collections": {
    "users": {
      "description": "User profiles for teachers and students",
      "fields": {
        "id": "string",
        "name": "string",
        "role": "string ('teacher' | 'student')",
        "username": "string",
        "phoneStudent": "string (optional)",
        "phoneParent": "string (optional)",
        "className": "string (optional)",
        "avatar": "string",
        "createdAt": "string"
      }
    },
    "assignments": {
      "description": "Assignments created by teachers",
      "fields": {
        "id": "string",
        "title": "string",
        "description": "string",
        "dueDate": "string",
        "classSessionId": "string (optional)",
        "classSessionTitle": "string (optional)",
        "type": "string ('online_test' | 'file_upload' | 'simulation')",
        "pdfUrl": "string (optional)",
