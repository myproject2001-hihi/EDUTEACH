        "title": "string",
        "content": "string",
        "envelopeStyle": "string ('rose_love' | 'pastel_gold' | 'ocean_blue' | 'vintage_warm')",
        "targetType": "string ('next_registered' | 'class' | 'specific_user' | 'all_teachers' | 'all_students')",
