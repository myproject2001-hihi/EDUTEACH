        "simulationUrl": "string (optional)",
        "createdAt": "string"
      }
    },
    "submissions": {
      "description": "Submissions by students",
      "fields": {
        "id": "string",
        "assignmentId": "string",
        "studentId": "string",
        "studentName": "string",
        "content": "string",
        "submittedAt": "string",
        "grade": "number (optional)",
        "feedback": "string (optional)",
        "fileUrl": "string (optional)",
        "quizAnswers": "map (optional)",
        "isPenalty": "boolean (optional)"
      }
    },
    "class_sessions": {
      "description": "Class schedules/buổi học",
      "fields": {
        "id": "string",
        "title": "string",
        "subject": "string (optional)",
        "startTime": "string",
        "endTime": "string",
        "link": "string",
        "note": "string (optional)"
      }
    },
    "simulations": {
      "description": "Custom interactive simulations",
      "fields": {
        "id": "string",
        "title": "string",
        "description": "string",
        "url": "string",
        "thumbnail": "string",
        "category": "string (optional)",
        "hasQuiz": "boolean (optional)",
        "htmlContent": "string (optional)"
      }
    },
    "student_progress": {
      "description": "Student academic performance reports",
      "fields": {
        "studentId": "string",
        "studentName": "string",
        "phoneParent": "string (optional)",
        "phoneStudent": "string (optional)",
        "className": "string (optional)",
        "completionRate": "number",
        "averageGrade": "number",
        "attendanceRate": "number",
        "monthlyProgress": "array (optional)"
      }
    },
    "system_notifications": {
      "description": "System updates and notifications",
      "fields": {
        "id": "string",
        "title": "string",
        "content": "string",
        "type": "string ('system_update' | 'badge_info' | 'class_reminder' | 'announcement')",
        "badge": "string",
        "badgeColor": "string (optional)",
        "createdAt": "string"
      }
    },
    "love_letters": {
      "description": "Love letters and celebratory messages sent by teachers to students",
      "fields": {
        "id": "string",
        "senderId": "string",
        "senderName": "string",
